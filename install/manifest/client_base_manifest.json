{
  "version": 1,
  "description": "Curated installable base workflow assets for client projects.",
  "dev_only_excludes": [
    "AGENTS.md",
    ".gitignore",
    ".codex/config.toml",
    "README_CSKM_PRO.md",
    "docs/plans",
    ".csk-app",
    "tools/csk/upstream_sync_manifest.json"
  ],
  "managed_cleanup_paths": [
    ".csk-base",
    ".agents/skills/csk-init",
    ".agents/skills/csk-adopt",
    ".agents/skills/csk-project-update"
  ],
  "bridge_cleanup_targets": [
    "AGENTS.md"
  ],
  "assets": [
    {
      "source": "install/source/base/.csk-base/README.md",
      "target": ".csk-base/README.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.csk-base/ENTRYPOINT.md",
      "target": ".csk-base/ENTRYPOINT.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.csk-base/docs/INIT_GUIDE.md",
      "target": ".csk-base/docs/INIT_GUIDE.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.csk-base/docs/UPDATE_GUIDE.md",
      "target": ".csk-base/docs/UPDATE_GUIDE.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.csk-base/CHANGELOG.md",
      "target": ".csk-base/CHANGELOG.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.csk-local/README.md",
      "target": ".csk-local/README.md",
      "ownership": "project-owned-template"
    },
    {
      "source": "install/source/base/.csk-local/examples/review.browser.md",
      "target": ".csk-local/examples/review.browser.md",
      "ownership": "project-owned-template"
    },
    {
      "source": "install/source/base/.agents/skills/csk-init/SKILL.md",
      "target": ".agents/skills/csk-init/SKILL.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.agents/skills/csk-adopt/SKILL.md",
      "target": ".agents/skills/csk-adopt/SKILL.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/base/.agents/skills/csk-project-update/SKILL.md",
      "target": ".agents/skills/csk-project-update/SKILL.md",
      "ownership": "managed"
    },
    {
      "source": "install/source/bridge/root_AGENTS_managed_block.md",
      "target": "AGENTS.md",
      "ownership": "bridge"
    }
  ]
}
